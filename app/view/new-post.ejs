<!--Form Field Names: newPostTitle, newPostContent-->


<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta2/dist/js/bootstrap-select.min.js"></script>


<div class="container mt-5 text-light">
    <h2 class="text-center mb-4">Create a New Blog Post</h2>

    <form action="/post/new" method="POST" enctype="multipart/form-data">
        <!-- Title Field -->
        <div class="mb-3">
            <label for="newPostTitle" class="form-label">Title</label>
            <input type="text" class="form-control" id="newPostTitle" name="newPostTitle" required>
        </div>

        <!-- Content Field -->
        <div class="mb-3">
            <label for="newPostContent" class="form-label">Blog Content</label>
            <textarea class="form-control" id="newPostContent" name="newPostContent" rows="6" required></textarea>
        </div>


        <!-- Categories Field -->
        <div class="mb-3">
            <label for="categories" class="form-label">Categories</label>
            <select class="selectpicker form-control" data-live-search="true" multiple title="Select categories" id="categories" name="newPostCategories">
                <% categories.forEach(category => { %>
                    <option value="<%= category._id %>"><%= category.name %></option>
                <% }) %>
            </select>
            <small class="text-muted">Start typing to search for a category.</small>
        </div>

        <input type="file" name="newPostImages" class="form-control mb-2" multiple>


        <button type="submit" class="btn btn-primary">Publish Post</button>
    </form>

    <a href="/" class="btn btn-secondary mt-3">Go Back</a>
</div>


<script>
        $(document).ready(function() {
        $('#categories').selectpicker();
    });
</script>


