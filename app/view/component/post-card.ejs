<!--Required Variables for importing this card:- Post, Category, bookmarkedPostIds-->

<!--Variables: post-title, post-author, post-content, post._id, bookmarkedPostIds -->
<!--bookmarkedPostIds variable is used for populating the bookmark button-->

<div class="card mb-4 border border-light bg-dark text-white position-relative">
    <div class="card-body">
        <h2 class="card-title"><a href="/post/<%= post._id %>"> <%= post.title %>  </a></h2>
        <p class="text-light small">By <a href="/user/<%= post.author._id%>">  <%= post.author.name %> </a>| <%= new Date(post.createdAt).toDateString() %>  &nbsp; <% post.categories.forEach(category => { %>
                <a href="/category/<%= category._id %>" class="badge bg-info text-dark"><%= category.name %></a>
            <% }) %></p>
        <p class="card-text"><%= post.content.substring(0, 200) %></p>

        <!-- Bookmark Button -->
        <% const isBookmarked = postCardData.bookmarkedPostIds.includes(post._id.toString()); %>
        <button
                class="btn btn-link bookmark-btn position-absolute top-0 end-0 m-3"
                data-post-id="<%= post._id %>"
                data-is-bookmarked=<%= isBookmarked %>>

            <i class="<%=  isBookmarked ? 'fas' : 'far' %> fa-bookmark text-light"></i>

        </button>

        <!-- Images Display -->
        <% if (post.imageUrls && post.imageUrls.length > 0) { %>
            <% post.imageUrls.forEach(imageUrl => { %>
                <img src="/uploads/post-images/<%= imageUrl %>" class="card-img-top m-2" style="max-height: 200px; width: auto" alt="Post Image">
            <% }) %>
        <% } %>
        <br>

    <% if (typeof showControls !== 'undefined' && showControls) { %>
            <button type="button" class="btn btn-warning edit-btn"
                    data-post-id="<%= post._id %>"
                    data-post-title="<%= post.title %>"
                    data-post-content="<%= post.content %>"
                    data-post-categories = "<%= JSON.stringify(post.categories) %>"
                    data-bs-toggle="modal"
                    data-bs-target="#editModal">
                Edit
            </button>
            <a href="/post/delete/<%= post._id %>" class="btn btn-danger">Delete</a>
        <% } %>
    </div>
</div>



