<div class="container mt-5 text-light">
    <div class="card bg-dark text-light shadow-lg">
        <div class="card-body">
            <!-- Post Title -->
            <h1 class="card-title text-center mb-3"><%= post.title %></h1>

            <!-- Author and Date -->
            <p class="text-center text-light">
                By <strong><%= post.author.name %></strong> | <%= new Date(post.createdAt).toLocaleDateString() %>
            </p>

            <hr>
            <p class="text-light small">
                <% post.categories.forEach(category => { %>
                    <a href="/category/<%= category._id %>" class="badge bg-info text-dark"><%= category.name %></a>
                <% }) %>
            </p>
            <!-- Post Content -->
            <p class="card-text" style="font-size: 1.2rem; line-height: 1.6;">
                <%= post.content %>
            </p>

            <!-- Images Display -->
            <% if (post.imageUrls && post.imageUrls.length > 0) { %>
                <% post.imageUrls.forEach(imageUrl => { %>
                    <img src="/uploads/post-images/<%= imageUrl %>" class="card-img-top m-2" style="max-height: 300px; width: auto" alt="Post Image">
                <% }) %>
            <% } %>
            <br>


            <hr>

            <!-- Back Button -->
            <div class="text-center mt-4">
                <a href="/" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>
