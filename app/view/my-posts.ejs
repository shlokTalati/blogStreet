<div class="container mt-5">
    <h2 class="text-center mb-4 text-white">My Posts</h2>

    <% if (posts.length > 0) { %>
        <% posts.forEach(post => { %>
            <%- include("component/post-card.ejs", { post: post, showControls: true }) %>
        <% }) %>
    <% } else { %>
        <p class="text-center text-white">You haven't posted anything yet.</p>
    <% } %>

    <!-- Single Reusable Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <form id="editForm" method="POST">
                    <!-- The action attribute will be set dynamically via JavaScript -->
                    <div class="modal-header">
                        <h5 class="modal-title" id="editModalLabel">Edit Post</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Title Field -->
                        <div class="mb-3">
                            <label for="editTitle" class="form-label">Title</label>
                            <input type="text" class="form-control" id="editTitle" name="editTitle" required>
                        </div>
                        <!-- Content Field -->
                        <div class="mb-3">
                            <label for="editContent" class="form-label">Content</label>
                            <textarea class="form-control" id="editContent" name="editContent" rows="5" required></textarea>
                        </div>
                        <!-- Categories Field (Searchable & Multi-Select via Bootstrap-Select) -->
                        <div class="mb-3">
                            <label for="editCategories" class="form-label">Categories</label>
                            <select class="selectpicker form-control" data-live-search="true" id="editCategories" name="editCategories" multiple title="Select categories">
                                <% categories.forEach(category => { %>
                                    <option value="<%= category._id %>"><%= category.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Initialize Bootstrap-Select -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta2/dist/css/bootstrap-select.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta2/dist/js/bootstrap-select.min.js"></script>

<!-- Script to populate the Edit Modal dynamically -->
<script>
    // When an edit button is clicked, populate the modal fields
    document.querySelectorAll('.edit-btn').forEach(button => {
        button.addEventListener('click', function() {
            const postId = this.getAttribute('data-post-id');
            const postTitle = this.getAttribute('data-post-title');
            const postContent = this.getAttribute('data-post-content');
            const postCategories = this.getAttribute('data-post-categories'); // Should be a comma-separated list of category IDs


            // Set the form action with the post ID
            document.getElementById('editForm').action = `/post/edit/${postId}`;

            // Populate modal fields
            document.getElementById('editTitle').value = postTitle;
            document.getElementById('editContent').value = postContent;


            // Populate the categories select
            // Parse categories JSON and extract IDs
            if (postCategories) {
                const selectedCategories = JSON.parse(postCategories).map(cat => cat._id);
                $('#editCategories').val(selectedCategories).selectpicker('refresh');
            } else {
                $('#editCategories').val([]).selectpicker('refresh');
            }
        });
    });
</script>